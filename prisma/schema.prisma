generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Loan {
  id            String    @id
  ownerId       String?
  name          String
  bank          String
  balance       Float
  totalInterest Float
  monthlyRate   Float
  interestRate  Float
  startDate     DateTime?
  endDate       DateTime?
  nextPayment   DateTime
  status        String
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Insurance {
  id                    String    @id
  ownerId               String?
  name                  String
  provider              String
  monthlyPremium        Float
  debitDay              Int
  paymentIntervalMonths Int       @default(1)
  firstDebitDate        DateTime?
  startDate             DateTime?
  endDate               DateTime?
  renewalDate           DateTime?
  coverage              String
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model GeneralContract {
  id                    String    @id
  ownerId               String?
  title                 String
  provider              String
  category              String
  monthlyAmount         Float
  debitDay              Int
  paymentIntervalMonths Int       @default(1)
  startDate             DateTime
  endDate               DateTime?
  note                  String?
  status                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Income {
  id        String   @id
  ownerId   String?
  title     String
  source    String
  amount    Float
  date      DateTime
  recurring Boolean
  entryDay  Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id
  ownerId   String?
  title     String
  category  String
  amount    Float
  date      DateTime
  recurring Boolean
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Investment {
  id            String   @id
  ownerId       String?
  assetName     String
  symbol        String
  quantity      Float
  purchasePrice Float
  purchaseDate  DateTime
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavingsGoal {
  id                  String    @id
  ownerId             String?
  name                String
  targetAmount        Float
  currentAmount       Float
  monthlyContribution Float
  targetDate          DateTime?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model SavingsTransaction {
  id            String   @id
  ownerId       String?
  savingsGoalId String
  type          String
  amount        Float
  date          DateTime
  note          String?
  expenseId     String?
  incomeId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MonthlyBudget {
  id       String  @id @default(cuid())
  ownerId  String?
  category String
  planned  Float
  spent    Float
}

model MonthlyCarryOver {
  id        String   @id @default(cuid())
  ownerId   String?
  month     String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, month])
}

model PaymentConfirmation {
  id         String   @id
  ownerId    String?
  paidAmount Float
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model AppUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  ownerId      String
  accessLevel  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RegistrationChallenge {
  id                   String   @id @default(cuid())
  username             String
  passwordHash         String
  telegramContact      String
  code                 String
  codeHash             String
  transferSharedUserId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
}

model TelegramContact {
  id        String   @id @default(cuid())
  username  String   @unique
  contact   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetChallenge {
  id        String   @id @default(cuid())
  username  String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ExpenseProject {
  id          String            @id
  ownerId     String?
  title       String
  startDate   DateTime
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  categories  ProjectCategory[]
  members     ProjectMember[]
  expenses    ProjectExpense[]
}

model ProjectCategory {
  id        String           @id
  ownerId   String?
  projectId String
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   ExpenseProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses  ProjectExpense[]

  @@unique([projectId, name])
}

model ProjectMember {
  id            String                @id
  ownerId       String?
  projectId     String
  name          String
  shareWeight   Float
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  project       ExpenseProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paidExpenses  ProjectExpense[]      @relation("ProjectExpensePayer")
  expenseShares ProjectExpenseShare[]
}

model ProjectExpense {
  id             String                @id
  ownerId        String?
  projectId      String
  amount         Float
  date           DateTime
  categoryId     String
  paidByMemberId String
  description    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  project        ExpenseProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       ProjectCategory       @relation(fields: [categoryId], references: [id])
  paidBy         ProjectMember         @relation("ProjectExpensePayer", fields: [paidByMemberId], references: [id])
  shares         ProjectExpenseShare[]
}

model ProjectExpenseShare {
  id          String         @id
  expenseId   String
  memberId    String
  shareWeight Float
  amount      Float
  createdAt   DateTime       @default(now())
  expense     ProjectExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member      ProjectMember  @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
}

model ShoppingItem {
  id          String    @id
  ownerId     String?
  name        String
  quantity    Float
  unit        String
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId, createdAt])
  @@index([ownerId, completedAt])
}
